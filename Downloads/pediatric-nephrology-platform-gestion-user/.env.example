# Google Cloud API Keys
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to Git!

# Google Vision API (for OCR)
GOOGLE_VISION_API_KEY=your_vision_api_key_here

# Google Translate API (for translation)
GOOGLE_TRANSLATE_API_KEY=your_translate_api_key_here

# Alternative: DeepL API (optional, for better translations)
DEEPL_API_KEY=your_deepl_api_key_here

# MongoDB Connection
MONGODB_URI=mongodb+srv://PediaLink:PediaLink@pedialink.0d8a5qd.mongodb.net/pedialink

# JWT Secret
JWT_SECRET=PediaLinkSuperSecretKeyForJwtToken2024MustBeAtLeast256BitsLong!!
